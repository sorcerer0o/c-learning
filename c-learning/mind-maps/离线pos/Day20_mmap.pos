{"diagram":{"image":{"x":0,"width":200,"y":0,"pngdata":"","height":200},"elements":{"leftChildren":[],"comments":[],"children":[{"parent":"root","children":[{"parent":"ff99060d215dcd42","children":[],"id":"2d598a833adf258b","title":"是一种内存映射，直接将文件里的内容映射到内存。&nbsp;操作这块内存，就等价于<br>操作这个文件"}],"id":"ff99060d215dcd42","title":"概述"},{"parent":"root","children":[{"parent":"5cc3f01e1764a423","children":[{"parent":"7a279f6eeadc4736","children":[],"id":"3c5d841e56441813","title":"#include &lt;sys/mman.h&gt;<br>void *mmap(void *addr, size_t length, int prot, int flags, int fd, off_t offset);"},{"parent":"7a279f6eeadc4736","children":[],"id":"1b719685df1fed21","title":"void *addr:&nbsp;内存从何处开始映射。建议直接写NULL"},{"parent":"7a279f6eeadc4736","children":[],"id":"608312c735dfa596","title":"length/offset:&nbsp;组合决定映射文件的哪块位置进来"},{"parent":"7a279f6eeadc4736","children":[{"parent":"ffc4b3b10c1e2d1d","children":[],"id":"8b0f4837e17cb05e","title":"PROT_READ:&nbsp;读"},{"parent":"ffc4b3b10c1e2d1d","children":[],"id":"afd1d84ab46528b5","title":"PROT_WRITE | PROT_READ :&nbsp;可读可写。&nbsp;建议大家一起协商"}],"id":"ffc4b3b10c1e2d1d","title":"int prot:&nbsp;映射了之后，内存的权限。&nbsp;"},{"parent":"7a279f6eeadc4736","children":[{"parent":"0de902ba61200653","children":[],"id":"303d98ef948be0ef","title":"MAP_SHARED<br>目前直接用它，保证修改完内存直接回写到文件中"}],"id":"0de902ba61200653","title":"int flags:&nbsp;映射的内存的回写特点。&nbsp;"},{"parent":"7a279f6eeadc4736","children":[],"id":"36bc29cdddbb5482","title":"int fd:&nbsp;打开的文件描述符"},{"parent":"7a279f6eeadc4736","children":[{"parent":"3549b4478dfaaeff","children":[],"id":"d58bafd297d28a92","title":"addr建议直接NULL"},{"parent":"3549b4478dfaaeff","children":[],"id":"f6a9a23be23a3ac4","title":"prot。如果只读PROT_READ；&nbsp;读写 PROT_READ | PROT_WRITE"},{"parent":"3549b4478dfaaeff","children":[],"id":"10707823780301fd","title":"flags&nbsp;建议直接写 MAP_SHARED"}],"id":"3549b4478dfaaeff","title":"建议的参数"},{"parent":"7a279f6eeadc4736","children":[{"parent":"60bac59079a45b73","children":[],"id":"e820bbd2450f1734","title":"如果成功，会返回指针。操作指针这块区域，就相当于操作文件"},{"parent":"60bac59079a45b73","children":[],"id":"aa713e70fd6dd71d","title":"如果失败，返回MAP_FAILED。&nbsp;"}],"id":"60bac59079a45b73","title":"返回值有点特殊"}],"id":"7a279f6eeadc4736","title":"mmap"},{"parent":"5cc3f01e1764a423","children":[{"parent":"174d13045b0eebc3","children":[],"id":"0e9c742569c17228","title":"传入获取到的void *"},{"parent":"174d13045b0eebc3","children":[],"id":"11448ec3f60c09ac","title":"length和获取时的保持一致"}],"id":"174d13045b0eebc3","title":"munmap"}],"id":"5cc3f01e1764a423","title":"使用"},{"parent":"root","children":[{"parent":"f3fd3670978b5516","children":[{"parent":"4bb9a295aafb8a5a","children":[],"id":"3244309a0126025f","title":"offset的取值，只能是4096的倍数。如果是其他值，这里会直接报错"}],"id":"4bb9a295aafb8a5a","title":"offset的取值问题"},{"parent":"f3fd3670978b5516","children":[{"parent":"dea41e80160ca6a6","children":[],"id":"6212002d3f08c4b7","title":"如果在mmap中，要访问的文件大小为0，但是却想映射几个字节，这时候就可能出现总线错误<br>"},{"parent":"dea41e80160ca6a6","children":[],"id":"e7d77050bf168ea9","title":"如果要映射的数目，大于了文件的实际大小。&nbsp;这时候访问超出的部分，也可能出现"}],"id":"dea41e80160ca6a6","title":"总线错误"},{"parent":"f3fd3670978b5516","children":[{"parent":"2185af85be0d6658","children":[],"id":"181c4eec7e8b541c","title":"如果只是想读数据，&nbsp;这时候open用&nbsp;O_RDONLY，mmap用PROT_READ"},{"parent":"2185af85be0d6658","children":[],"id":"7227516b2866795a","title":"如果想写数据，这时候open&nbsp;用O_RDWR， mmap用 PROT_READ|PROT_WRITE"}],"id":"2185af85be0d6658","title":"open的flag和mmap的prot"}],"id":"f3fd3670978b5516","title":"一些坑"},{"parent":"root","children":[{"parent":"3527827da5515ef8","children":[],"id":"c4a5e41d70b954f8","title":"fread&nbsp; 有缓冲文件流。用来读文件的<br><br>read&nbsp; 无缓冲文件流。读文件的。<br><br>mmap&nbsp; 文件映射。 <br><br>如果说是操作普通文件， fread和read都可以。 read要注意一下读的数组大点。<br>后续，在Linux下开发， read和write，可能出现的会更多。 <br>如果说要做大文件的复制。 这时候可以考虑使用mmap来提高效率。 <br><br>理论上， read比fread少一次数据拷贝； mmap比read少一次数据拷贝。&nbsp;<br>"},{"parent":"3527827da5515ef8","children":[],"id":"34a9788f249976e3","title":"数据复制了几次，要知道。&nbsp;<br>有缓冲区文件流，拷了两次数据。&nbsp;一次是从内核到用户态缓冲区，一次是用户态缓冲区到自己的数组。&nbsp;<br>无缓冲区文件流，拷了一次数据。&nbsp;从内核到自己的数组。&nbsp;<br>mmap，没有拷贝数据。&nbsp;我们拿到的指针，是内核开的后门。"}],"collapsed":false,"id":"3527827da5515ef8","title":"fread&amp;read&amp;mmap对比"},{"parent":"root","children":[{"parent":"b7d850a0ec699dc7","children":[{"parent":"6ca653df5eed2c5e","children":[],"id":"e2379c086b10b6a0","title":"将文件中的小写字母，转成大写字母，其他的不动"},{"parent":"6ca653df5eed2c5e","children":[],"id":"714c31aca92e1aef","title":"思路就是利用mmap将数据映射进来，挨个检查，是小写，就转成大写。&nbsp;再放回原本的位置上<br>"},{"parent":"6ca653df5eed2c5e","children":[{"parent":"a0c24e086c8c9500","children":[],"id":"ddca5ef9d32b815b","title":"其他的参数一模一样，之前之前stat传path。现在传fd"},{"parent":"a0c24e086c8c9500","children":[],"id":"4963a5a5ab0eccca","title":"可以从buf里面，拿到st_size&nbsp;就是大小"}],"id":"a0c24e086c8c9500","title":"在这个过程中，我们发现mmap的时候。&nbsp;要传length。这时候<br>学会另一个系统调用 fstat"},{"parent":"6ca653df5eed2c5e","children":[{"parent":"4758332ed9763292","children":[],"id":"fec8bc27fc0f042b","title":"要注意一下，读取了之后，指针会往后挪。&nbsp;所以有一个和fseek类似的函数， lseek<br>大家晚上可以练习一下"}],"id":"4758332ed9763292","title":"如果使用read/write函数"}],"collapsed":false,"id":"6ca653df5eed2c5e","title":"小写转大写"},{"parent":"b7d850a0ec699dc7","children":[{"parent":"991bfe38fc4c4d0c","children":[],"id":"a2dadc2be55cfbbb","title":"就意味着文件很大，我们无法一次弄进来。&nbsp;"},{"parent":"991bfe38fc4c4d0c","children":[{"parent":"e59d0f1cb4037ccb","children":[],"id":"997146af12ad7770","title":"首先，先将文件大小获取到。 100M&nbsp;<br>一次获取一点进来。 4M. len+offset&nbsp;"}],"id":"e59d0f1cb4037ccb","title":"如果是使用read/write.其实无所谓，弄个循环使劲循环就完了。<br>但是对于mmap，这种思路不行"},{"parent":"991bfe38fc4c4d0c","children":[{"parent":"773e3d9e2ab348c6","children":[],"id":"42e25a1a80108945","title":"既然不能一把整进来。这时候一点点弄进来。<br>这时候要手动存储，已经读取的大小。以及偏移量各种信息，需要自己来处理"},{"parent":"773e3d9e2ab348c6","children":[{"parent":"3ed3a2fc099b357a","children":[],"id":"d4560477585c5fb7","title":"offset一定要是4K的倍数"}],"id":"3ed3a2fc099b357a","title":"length和offset"},{"parent":"773e3d9e2ab348c6","children":[],"id":"8e52cb1ca84e43d3","title":"在这次复制中，copied_size，&nbsp;"}],"id":"773e3d9e2ab348c6","title":"思路"}],"collapsed":false,"id":"991bfe38fc4c4d0c","title":"大文件的复制"}],"id":"b7d850a0ec699dc7","title":"案例"}],"root":true,"theme":"theme_wps_def","showWatermark":false,"id":"root","title":"mmap","version":131,"structure":"mind_free"}},"meta":{"exportTime":"2025-05-14 21:34:36","member":"","diagramInfo":{"creator":"","created":"","modified":"","title":"","category":""},"id":"","type":"ProcessOn Schema File","version":"1.0"}}